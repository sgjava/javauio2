/dts-v1/;
/plugin/;

/ {
    compatible = "allwinner,sun50i-a64";

    fragment@0 {
        target = <&spi0>;
        __overlay__ {
            status = "okay";

            spidev@0 {
                compatible = "rohm,dh2228fv";
                reg = <0>;
                spi-max-frequency = <32000000>;
            };
        };
    };

    fragment@1 {
        target = <&spi1>;
        __overlay__ {
            status = "okay";

            spidev@1 {
                compatible = "rohm,dh2228fv";
                reg = <0>;
                spi-max-frequency = <2000000>; // 2 MHz for XPT2046
            };
        };
    };
};
